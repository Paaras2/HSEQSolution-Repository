<?xml version="1.0" encoding="utf-8"?>
<!--
  پیکربندی IIS برای فایل‌های استاتیک کلاینت.

  از پوشه‌ی public می‌آید، پس Vite خودش آن را داخل dist کپی می‌کند و در بسته‌ی انتشار
  کنار index.html می‌نشیند.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!--
          مسیریابی سمت کلاینت: React Router مسیرهایی مثل /documents و /admin دارد که
          روی دیسک فایلی ندارند. بدون این قاعده، رفرش کردن یا باز کردن مستقیم لینک
          خطای 404 می‌داد.

          سه شرط جلوی قاعده را می‌گیرند تا فایل‌های واقعی و API دست‌نخورده بمانند.
        -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- فایل واقعی (js/css/تصویر/فونت) همان‌طور که هست سرو شود -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!--
              بک‌اند به‌عنوان Application با مسیر /api زیر همین سایت ثبت شده. این شرط
              تضمین می‌کند درخواست‌های API هرگز به index.html بازنویسی نشوند - وگرنه
              کلاینت به‌جای JSON، صفحه‌ی HTML می‌گرفت و خطاهای گیج‌کننده می‌داد.
            -->
            <add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- فونت‌ها و نوع‌هایی که IIS به‌صورت پیش‌فرض نمی‌شناسد و 404 می‌دهد -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- سرصفحه‌های امنیتی پایه برای محتوای استاتیک -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
        <!-- نسخه‌ی IIS و ASP.NET را از پاسخ برمی‌دارد -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
