<?xml version="1.0" encoding="utf-8"?>
<!--
  پیکربندی IIS برای بک‌اند.

  این فایل در زمان publish توسط SDK تکمیل می‌شود: processPath و arguments و
  hostingModel را خودش می‌نویسد. چیزی که اینجا دستی تعیین شده، فقط مسیر لاگ است.

  چرا مسیر لاگ مطلق و بیرون از پوشه‌ی برنامه است: مقدار پیش‌فرضِ SDK برابر
  ".\logs\stdout" است، یعنی داخل همان پوشه‌ای که هر استقرار جدید رویش کپی می‌شود.
  لاگِ عیب‌یابی دقیقاً همان چیزی است که بعد از یک استقرارِ خراب لازم می‌شود، پس
  نباید با استقرار بعدی پاک شود. مسیر زیر همان جایی است که Deploy-Production.ps1
  می‌سازد و به هویت Application Pool روی آن دسترسی Modify می‌دهد.

  stdoutLogEnabled الان true است، چون برای عیب‌یابیِ این استقرار خواسته شده.

  ⚠ این لاگ چرخش (rotation) ندارد. هر بار که برنامه بالا می‌آید یک فایل تازه ساخته
  می‌شود و هیچ‌کدام هرگز پاک نمی‌شوند. روی سروری که ماه‌ها بالا می‌ماند، این یعنی
  پر شدن تدریجی دیسک - و پر شدن دیسک، خودش کل سایت را می‌خواباند.

  پس از اینکه استقرار تثبیت شد، این را دوباره false کنید:
      stdoutLogEnabled="false"
  و فایل‌های قدیمی C:\ApplicationData\HSEQ\logs\ را پاک کنید.

  لاگِ دقیق‌ترِ خودِ برنامه از Logging:LogLevel در appsettings.Production.json
  کنترل می‌شود - آن یکی چرخش ندارد ولی حجمش هم به‌مراتب کمتر است.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\HSEQ.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\ApplicationData\HSEQ\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
