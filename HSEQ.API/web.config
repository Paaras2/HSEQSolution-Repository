<?xml version="1.0" encoding="utf-8"?>
<!--
  پیکربندی IIS برای بک‌اند.

  این فایل در زمان publish توسط SDK تکمیل می‌شود: processPath و arguments و
  hostingModel را خودش می‌نویسد. چیزی که اینجا دستی تعیین شده، فقط مسیر لاگ است.

  چرا مسیر لاگ مطلق و بیرون از پوشه‌ی برنامه است: مقدار پیش‌فرضِ SDK برابر
  ".\logs\stdout" است، یعنی داخل همان پوشه‌ای که هر استقرار جدید رویش کپی می‌شود.
  لاگِ عیب‌یابی دقیقاً همان چیزی است که بعد از یک استقرارِ خراب لازم می‌شود، پس
  نباید با استقرار بعدی پاک شود. مسیر زیر همان جایی است که Deploy-Production.ps1
  می‌سازد و به هویت Application Pool روی آن دسترسی Modify می‌دهد.

  stdoutLogEnabled عمداً false است: این لاگ چرخش (rotation) ندارد و روشن ماندنش
  در درازمدت دیسک را پر می‌کند. برای عیب‌یابی موقتاً true کنید، مشکل را پیدا کنید
  و دوباره false کنید.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\HSEQ.API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile="C:\ApplicationData\HSEQ\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
